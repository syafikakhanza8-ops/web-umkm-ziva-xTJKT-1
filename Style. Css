@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap');

:root {
  --pink: #e96f91;
  --pink-dark: #c94f75;
  --cream: #fff8f1;
  --brown: #594238;
  --muted: #786b65;
  --white: #ffffff;
  --shadow: 0 12px 35px rgba(89, 66, 56, 0.09);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--brown);
  background: var(--white);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.65;
}
a { color: inherit; text-decoration: none; }
.container { width: min(1100px, 90%); margin: 0 auto; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid #f5e9e4;
  backdrop-filter: blur(10px);
}
.navbar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.logo { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 800; color: var(--brown); }
.logo span, .hero h1 span, .section-title span, .contact h2 span { color: var(--pink); }
.nav-links { display: flex; gap: 28px; color: var(--muted); font-size: .95rem; }
.nav-links a:hover { color: var(--pink-dark); }

.hero { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 45px; padding-top: 76px; padding-bottom: 85px; }
.eyebrow { margin: 0 0 10px; color: var(--pink-dark); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .76rem; }
h1, h2, h3, p { margin-top: 0; }
.hero h1, .contact h2 { max-width: 650px; margin-bottom: 18px; font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 5vw, 4.3rem); line-height: 1.12; }
.hero-description { max-width: 540px; margin-bottom: 28px; color: var(--muted); }
.button { display: inline-block; padding: 13px 24px; border-radius: 999px; color: var(--white); background: var(--pink); font-weight: 700; box-shadow: 0 8px 20px rgba(233, 111, 145, .23); transition: .2s ease; }
.button:hover { background: var(--pink-dark); transform: translateY(-2px); }
.hero-art { position: relative; min-height: 330px; display: grid; place-items: center; border-radius: 48% 52% 45% 55%; background: #fff0e7; }
.cake-emoji { font-size: clamp(8rem, 20vw, 13rem); filter: drop-shadow(0 16px 12px rgba(89,66,56,.12)); }
.sparkle { position: absolute; color: var(--pink); font-size: 2.5rem; }
.sparkle-one { top: 35px; left: 20%; }
.sparkle-two { right: 18%; bottom: 45px; }
.art-note { position: absolute; right: 7%; top: 18%; padding: 13px 17px; border-radius: 15px; background: white; color: var(--pink-dark); font-weight: 700; transform: rotate(8deg); box-shadow: var(--shadow); }

.section { padding: 78px 0; }
.products { background: var(--cream); }
.centered, .section-title, .section-intro { text-align: center; }
.section-title { margin-bottom: 8px; font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); }
.section-intro { margin-bottom: 35px; color: var(--muted); }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.product-card { overflow: hidden; border-radius: 20px; background: white; box-shadow: var(--shadow); transition: transform .2s ease; }
.product-card:hover { transform: translateY(-5px); }
.product-art { min-height: 190px; display: grid; place-items: center; font-size: 5.5rem; }
.product-art.pink { background: #ffe2e8; }
.product-art.yellow { background: #fff0c9; }
.product-art.brown { background: #f1dfd2; }
.product-info { padding: 22px; }
.product-info h3 { margin-bottom: 6px; font-family: 'Playfair Display', serif; font-size: 1.25rem; }
.product-info p { min-height: 50px; margin-bottom: 12px; color: var(--muted); font-size: .92rem; }
.product-info strong { color: var(--pink-dark); }
.price-note { margin: 20px 0 0; color: var(--muted); text-align: center; font-size: .8rem; }

.about { display: grid; grid-template-columns: .65fr 1.35fr; align-items: center; gap: 40px; max-width: 900px; }
.about-icon { display: grid; place-items: center; min-height: 210px; border-radius: 28px; background: #fff0e7; font-size: 6rem; }
.about .section-title { text-align: left; }
.about p:last-child { margin-bottom: 0; color: var(--muted); }

.contact { padding: 75px 0; color: white; text-align: center; background: var(--brown); }
.contact .eyebrow { color: #ffc0d0; }
.contact h2 { margin: 0 auto 14px; font-size: clamp(2rem, 4vw, 3rem); }
.contact h2 span { color: #ffb4c8; }
.contact p { color: #f1e3dd; }
.button-light { color: var(--brown); background: white; box-shadow: none; }
.button-light:hover { color: white; }
.contact small { display: block; margin-top: 13px; color: #d8c7bf; }
.footer { padding: 20px; background: #49352d; color: #eadbd4; text-align: center; font-size: .85rem; }
.footer p { margin: 0; }

.error-page { min-height: 100vh; display: grid; place-items: center; padding: 25px; background: var(--cream); }
.error-card { width: min(520px, 100%); padding: 45px 30px; border-radius: 25px; background: white; text-align: center; box-shadow: var(--shadow); }
.error-emoji { margin-bottom: 10px; font-size: 4rem; }
.error-card h1 { margin: 0; color: var(--pink); font-family: 'Playfair Display', serif; font-size: 5rem; line-height: 1; }
.error-card h2 { margin: 12px 0; font-family: 'Playfair Display', serif; font-size: 1.6rem; }
.error-card p:not(.eyebrow) { margin-bottom: 25px; color: var(--muted); }

@media (max-width: 700px) {
  .navbar { padding: 12px 0; flex-direction: column; }
  .nav-links { flex-wrap: wrap; justify-content: center; gap: 10px 18px; font-size: .88rem; }
  .hero { grid-template-columns: 1fr; padding-top: 48px; gap: 35px; }
  .hero-art { min-height: 260px; }
  .product-grid { grid-template-columns: 1fr; }
  .product-art { min-height: 160px; }
  .about { grid-template-columns: 1fr; gap: 25px; }
  .about-icon { min-height: 150px; }
}

