/* YUMMY - style.css */
:root {
  --pink: #e86f91;
  --pink-dark: #cf5278;
  --pink-soft: #fff0f4;
  --cream: #fffaf5;
  --brown: #513b35;
  --muted: #887a74;
  --white: #fff;
  --shadow: 0 10px 30px rgba(81, 59, 53, .10);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { font-family: Arial, Helvetica, sans-serif; color: var(--brown); background: var(--white); line-height: 1.6; }
a { color: inherit; text-decoration: none; }
.container { width: 90%; max-width: 1100px; margin: 0 auto; }

/* Navigasi */
.site-header { position: sticky; top: 0; z-index: 100; background: var(--white); border-bottom: 1px solid #f3e5e5; }
.navbar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.logo { color: var(--brown); font-family: Georgia, "Times New Roman", serif; font-size: 30px; font-weight: bold; }
.logo span, .hero h1 span, .section-title span { color: var(--pink); }
.nav-links { display: flex; align-items: center; gap: 26px; }
.nav-links a { color: var(--muted); font-size: 14px; font-weight: bold; transition: color .2s; }
.nav-links a:hover { color: var(--pink-dark); }

/* Tombol dan teks */
.eyebrow { margin-bottom: 10px; color: var(--pink-dark); font-size: 12px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; }
.button { display: inline-block; padding: 13px 25px; border: 2px solid var(--pink); border-radius: 30px; background: var(--pink); color: var(--white); font-size: 14px; font-weight: bold; transition: .2s; }
.button:hover { border-color: var(--pink-dark); background: var(--pink-dark); transform: translateY(-2px); }

/* Beranda */
.hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 45px; padding-top: 75px; padding-bottom: 80px; }
.hero h1 { margin-bottom: 18px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(38px, 5vw, 62px); line-height: 1.15; }
.hero-description { max-width: 520px; margin-bottom: 25px; color: var(--muted); font-size: 16px; }
.hero-art { position: relative; min-height: 320px; display: flex; align-items: center; justify-content: center; border-radius: 48% 52% 45% 55%; background: var(--pink-soft); }
.cake-emoji { font-size: 150px; filter: drop-shadow(0 12px 10px rgba(81, 59, 53, .12)); }
.sparkle { position: absolute; color: var(--pink); font-size: 35px; }
.sparkle-one { top: 35px; left: 20%; }
.sparkle-two { right: 18%; bottom: 35px; }
.art-note { position: absolute; top: 18%; right: 5%; padding: 12px 16px; border-radius: 12px; background: var(--white); color: var(--pink-dark); font-weight: bold; text-align: center; box-shadow: var(--shadow); transform: rotate(7deg); }

/* Produk */
.section { padding: 75px 0; }
.products { background: var(--cream); }
.centered, .section-title, .section-intro { text-align: center; }
.section-title { margin-bottom: 10px; font-family: Georgia, "Times New Roman", serif; font-size: 38px; }
.section-intro { margin-bottom: 35px; color: var(--muted); }
.product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
.product-card { overflow: hidden; border-radius: 18px; background: var(--white); box-shadow: var(--shadow); transition: transform .2s, box-shadow .2s; }
.product-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(81, 59, 53, .15); }
.product-art { min-height: 185px; display: flex; align-items: center; justify-content: center; font-size: 85px; }
.product-art.pink { background: #ffe3eb; }
.product-art.yellow { background: #fff1cc; }
.product-art.brown { background: #f0dfd3; }
.product-info { padding: 22px; }
.product-info h3 { margin-bottom: 8px; font-family: Georgia, "Times New Roman", serif; font-size: 21px; }
.product-info p { min-height: 48px; margin-bottom: 12px; color: var(--muted); font-size: 14px; }
.product-info strong { color: var(--pink-dark); font-size: 17px; }
.price-note { margin-top: 20px; color: var(--muted); font-size: 12px; text-align: center; }

/* Tentang */
.about { display: grid; grid-template-columns: .7fr 1.3fr; align-items: center; gap: 40px; max-width: 950px; }
.about-icon { min-height: 210px; display: flex; align-items: center; justify-content: center; border-radius: 25px; background: var(--pink-soft); font-size: 90px; }
.about .section-title { text-align: left; }
.about p:last-child { color: var(--muted); }

/* Kontak */
.contact { padding: 75px 0; background: var(--brown); color: var(--white); text-align: center; }
.contact .eyebrow { color: #ffc2d2; }
.contact h2 { margin: 0 auto 15px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(30px, 4vw, 44px); line-height: 1.2; }
.contact h2 span { color: #ffb5ca; }
.contact p { margin-bottom: 22px; color: #f0dfd9; }
.button-light { border-color: var(--white); background: var(--white); color: var(--brown); }
.button-light:hover { border-color: var(--pink); background: var(--pink); color: var(--white); }
.contact small { display: block; margin-top: 12px; color: #ddcbc4; font-size: 11px; }

/* Footer */
.footer { padding: 20px 10px; background: #402e29; color: #f5e8e3; text-align: center; font-size: 13px; }
.footer p { margin: 0; }

/* Halaman error 404 */
.error-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 25px; background: var(--cream); }
.error-card { width: 100%; max-width: 520px; padding: 45px 30px; border-radius: 22px; background: var(--white); box-shadow: var(--shadow); text-align: center; }
.error-emoji { margin-bottom: 12px; font-size: 65px; }
.error-card h1 { color: var(--pink); font-family: Georgia, "Times New Roman", serif; font-size: 85px; line-height: 1; }
.error-card h2 { margin: 12px 0; font-family: Georgia, "Times New Roman", serif; font-size: 25px; }
.error-card p:not(.eyebrow) { margin-bottom: 25px; color: var(--muted); }

/* Tampilan tablet dan HP */
@media (max-width: 768px) {
  .navbar { padding: 12px 0; flex-direction: column; }
  .nav-links { flex-wrap: wrap; justify-content: center; gap: 10px 18px; }
  .hero { grid-template-columns: 1fr; gap: 35px; padding-top: 45px; padding-bottom: 55px; }
  .hero-art { min-height: 260px; }
  .cake-emoji { font-size: 120px; }
  .product-grid { grid-template-columns: 1fr; }
  .product-art { min-height: 160px; }
  .about { grid-template-columns: 1fr; gap: 25px; }
  .about-icon { min-height: 160px; }
  .section { padding: 55px 0; }
}

@media (max-width: 400px) {
  .nav-links { gap: 8px 13px; }
  .nav-links a { font-size: 12px; }
  .hero h1 { font-size: 36px; }
  .section-title { font-size: 31px; }
  .error-card { padding: 35px 20px; }
}
